# Copy to .env and fill in. Database must be created first with backend/database/init.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_room
DB_USER=root
DB_PASSWORD=CHANGE_ME_database_password
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TEST_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=smartroom
MQTT_PASSWORD=CHANGE_ME_mqtt_password
MQTT_PORT=1883
SERVER_PORT=8080
COMMAND_TIMEOUT_MS=10000
SENSOR_STALE_MS=15000
APP_TIME_ZONE=Asia/Ho_Chi_Minh
SESSION_HOURS=8
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
